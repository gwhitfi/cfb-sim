{
  // Zone coverage areas: a drop landmark (play frame) plus width and a depth band.
  // "strong" / "weak" resolve from the defensive playbook's strength call.
  "format_version": 1,
  "zones": {
    "deep_half_strong":   {"drop": {"x": {"from": "hash", "side": "strong", "offset": 0}, "y": 15}, "width": 26, "depth": [12, 45]},
    "deep_half_weak":     {"drop": {"x": {"from": "hash", "side": "weak", "offset": 0}, "y": 15},   "width": 26, "depth": [12, 45]},

    "deep_third_strong":  {"drop": {"x": {"from": "numbers", "side": "strong", "offset": 0}, "y": 15}, "width": 18, "depth": [10, 45]},
    "deep_middle":        {"drop": {"x": 0, "y": 15},                                               "width": 18, "depth": [10, 45]},
    "deep_third_weak":    {"drop": {"x": {"from": "numbers", "side": "weak", "offset": 0}, "y": 15},   "width": 18, "depth": [10, 45]},

    "deep_quarter_strong_out": {"drop": {"x": {"from": "numbers", "side": "strong", "offset": 0}, "y": 12}, "width": 13, "depth": [10, 45]},
    "deep_quarter_strong_in":  {"drop": {"x": {"from": "hash", "side": "strong", "offset": 0}, "y": 12},    "width": 13, "depth": [10, 45]},
    "deep_quarter_weak_in":    {"drop": {"x": {"from": "hash", "side": "weak", "offset": 0}, "y": 12},      "width": 13, "depth": [10, 45]},
    "deep_quarter_weak_out":   {"drop": {"x": {"from": "numbers", "side": "weak", "offset": 0}, "y": 12},   "width": 13, "depth": [10, 45]},

    "curl_flat_strong":   {"drop": {"x": {"from": "numbers", "side": "strong", "offset": 0}, "y": 8}, "width": 12, "depth": [0, 12]},
    "curl_flat_weak":     {"drop": {"x": {"from": "numbers", "side": "weak", "offset": 0}, "y": 8},   "width": 12, "depth": [0, 12]},
    "hook_curl_strong":   {"drop": {"x": {"from": "hash", "side": "strong", "offset": 0}, "y": 10},   "width": 10, "depth": [5, 15]},
    "hook_curl_weak":     {"drop": {"x": {"from": "hash", "side": "weak", "offset": 0}, "y": 10},     "width": 10, "depth": [5, 15]},
    "hook_middle":        {"drop": {"x": 0, "y": 10},                                                 "width": 10, "depth": [5, 15]},
    "flat_strong":        {"drop": {"x": {"from": "numbers", "side": "strong", "offset": 2}, "y": 5}, "width": 10, "depth": [0, 8]},
    "flat_weak":          {"drop": {"x": {"from": "numbers", "side": "weak", "offset": 2}, "y": 5},   "width": 10, "depth": [0, 8]},
    "hole":               {"drop": {"x": 0, "y": 8},                                                  "width": 8,  "depth": [4, 14]}
  }
}
