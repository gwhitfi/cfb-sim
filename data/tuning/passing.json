{
  // The QB, throws, ball flight, and catches
  // (docs/design/movement-and-interaction.md#passing-game).
  "format_version": 1,

  "ball": {
    "gravity": 10.73  // yd/s^2
  },

  "qb": {
    // Seconds spent on one read: Decisions + Coverage Reading.
    "look_skill": {"decisions": 0.5, "coverage_reading": 0.5},
    "look_seconds": {"curve": "linear", "points": [[0, 0.8], [100, 0.3]]},
    "min_look_seconds": 0.15,  // looking at a read at least this long before throwing it
    // Perceived openness = true openness + a bias drawn when he starts looking.
    "perceive_skill": {"vision": 0.5, "coverage_reading": 0.5},
    "perceive_sd": {"curve": "linear", "points": [[0, 0.25], [100, 0.04]]},
    // Decisions -> perceived openness needed to throw.
    "throw_threshold": {"curve": "linear", "points": [[0, 0.55], [100, 0.75]]},
    "decay_after": 1.5,       // s after he's set, the threshold starts dropping...
    "decay_rate": 0.15,       // ...this much per second...
    "threshold_floor": 0.3,   // ...down to this
    "covered": 0.2,           // a read that looks this covered is dropped after the minimum look
    // Vision -> per-second chance of noticing a wide-open receiver he isn't reading.
    "peripheral_rate": {"curve": "linear", "points": [[0, 0.2], [100, 1.0]]},
    "wide_open": 0.85,
    "peripheral_min_depth": 5.0,  // yd downfield: a checkdown behind the line doesn't catch his eye
    "give_up_seconds": 4.5,   // s after the snap: throw the best he's seen, or throw it away
    "throw_away_past": 5.0    // yd past the receiver nearest the sideline, out of bounds
  },

  // How open a receiver is: the chance a good throw now is completed.
  "openness": {
    "contest_scale": 0.2,     // s: defender arrival margin -> contest (a logistic)
    "contest_bias": 0.0,
    "contest_weight": 0.6,    // a defender there in time takes away this share (he loses some contests)
    "lane_factor": 0.7,       // weight of a defender undercutting the throw on its way
    "projection_rounds": 4    // iterations for the projected catch point
  },

  "throw": {
    // Throw Power -> top ball speed, yd/s (about 27 yd/s is a 55 mph throw).
    "speed": {"curve": "linear", "points": [[1, 13.5], [100, 26]]},
    // Air distance (yd) -> share of top speed used: short throws are softer.
    "effort": {"curve": "linear", "points": [[0, 0.6], [25, 1.0]]},
    // Delivery -> seconds from deciding to throw until the ball is out.
    "delivery_seconds": {"curve": "linear", "points": [[0, 0.5], [100, 0.2]]},
    // Accuracy (short, medium, or deep by air distance) -> placement error sd, yd.
    "accuracy_sd": {"curve": "linear", "points": [[0, 2.7], [50, 1.1], [100, 0.7]]},
    "short_max": 10,   // yd of air distance
    "medium_max": 20,
    // Air distance -> multiplier on the error sd: longer throws miss by more.
    "distance_scale": {"curve": "linear", "points": [[0, 0.6], [10, 1.0], [20, 1.5], [30, 2.4], [40, 3.2]]},
    "height_sd_factor": 0.5,  // height error sd = this x placement sd
    // Throwing while moving faster than this (yd/s) scales the error by
    // Throw on the Run -> multiplier.
    "on_the_run_speed": 1.5,
    "on_the_run_factor": {"curve": "linear", "points": [[0, 2.0], [100, 1.15]]},
    "release_height_factor": 1.05,  // release height = QB height x this
    "target_height": 1.3            // yd: aim at the chest
  },

  "catch": {
    "arms_up_factor": 1.2,  // highest catch point = height x this + jump
    "jump": {"curve": "linear", "points": [[0, 0.1], [100, 0.5]]},  // Jumping -> yd
    "low": 0.15,            // yd: lowest catchable height
    // How far he can stretch. Body control (a blend) shapes the window: near his
    // body he has the whole height range, at full stretch only the middle of it.
    // Window: (d / reach)^n + (|z - mid| / half)^n <= 1, n from window_shape.
    "body_control": {"agility": 0.6, "balance": 0.4},
    "window_shape": {"curve": "linear", "points": [[0, 2.0], [100, 6.0]]},
    "dive_extra": {"curve": "linear", "points": [[0, 0.5], [100, 1.0]]},  // yd beyond reach
    "dive_max_height": 1.6, // yd: a dive is a low ball; nobody dives for one higher than this
    "dive_down": [0.8, 1.2],  // s on the ground after a dive that doesn't end the play
    "dive_slide": 0.25,       // share of his speed a diver keeps as he hits the ground
    // Jumping: a player who can play a ball passing above his hands jumps
    // (height from "jump" above), to put it this far under his hands ...
    "jump_comfort": 0.3,
    // ... timed to peak as it arrives, off by a normal error (sd from his skill).
    "jump_timing": {
      "defense": {"ball_skills": 1.0},
      "offense": {"contested_catch": 1.0},
      "sd": {"curve": "linear", "points": [[0, 0.15], [100, 0.03]]}
    },
    "jump_look_ahead": 0.8,   // s of the ball's flight he looks ahead
    "hold_ease": 0.25,        // s for a caught ball to come in to the carry spot
    "dive_factor": 0.45,    // catch chance multiplier for a diving catch
    // Catching -> chance of catching a ball thrown right at him, uncontested.
    "base": {"curve": "linear", "points": [[0, 0.55], [50, 0.9], [100, 0.985]]},
    // Reaching costs: at the edge of his window (out to the side, up at the top
    // of his jump, or down low) the chance drops by this share, as stretch^power
    // (stretch: 0 at the middle of the window, 1 at its edge).
    "reach_penalty": 0.4,
    "reach_penalty_power": 4,
    "fast_ball_speed": 22,  // yd/s: faster balls are harder to catch...
    "fast_ball_penalty": 0.01  // ...by this share per yd/s over
  },

  // Catches with defenders around (movement-and-interaction.md#catches-against-defenders).
  "contested": {
    "traffic_range": 1.5,     // yd: a defender this close is traffic
    "traffic_penalty": {"curve": "linear", "points": [[0, 0.15], [100, 0.03]]},  // Catch in Traffic -> share lost
    "traffic_bravery_share": 0.25,  // Bravery's share in that rating
    "receiver": {"contested_catch": 0.5, "catching": 0.2, "jumping": 0.15, "strength": 0.15},
    "defender": {"ball_skills": 0.6, "jumping": 0.2, "strength": 0.2},
    "closer_bonus": 10,       // skill points for being closer to the ball
    "skill_scale": 15,
    "catch_factor": 0.75,     // a receiver who wins the contest still has to hold on
    "int_contested": {"curve": "linear", "points": [[0, 0.035], [100, 0.17]]}, // Ball Skills
    "dive_int_factor": 0.03,  // ... times this for a defender diving through the receiver: almost never
    "int_alone": {"curve": "linear", "points": [[0, 0.10], [100, 0.30]]},     // Ball Skills, once he has a hand on it
    // A defender alone at the ball gets a hand on it (Ball Skills -> chance,
    // scaled by reach and dive like a catch); otherwise it goes by him.
    "touch": {"curve": "linear", "points": [[0, 0.35], [100, 0.85]]},
    // A defender who can't see it coming: full chance with the ball up to 90
    // degrees off his facing, falling to this share from straight behind.
    // (Receivers track the ball over the shoulder, so they don't pay it.)
    "behind_factor": 0.2,
    "bat_factor": 0.25,       // a lineman at the line has to get his hands up in time
    "line_depth": 2.5,        // yd: defenders this close to the line are at the line
    "tip_chance": 0.25,       // a breakup or drop stays live
    "tip_keep": 0.3,          // share of its velocity a tipped ball keeps
    "tip_up": [1.0, 3.0]      // yd/s added upward
  }
}
