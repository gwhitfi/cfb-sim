{
  // Running a play: the pre-snap, the snap, reactions, busts, routes, and the
  // stand-in blocking and run game used until phases 6-7
  // (docs/design/movement-and-interaction.md#assignment-execution).
  "format_version": 1,

  "presnap": {
    "huddle_depth": 9,       // yd behind the ball
    "huddle_spacing": 1.3,   // yd between players in the huddle
    "huddle_break": 0.5,     // s after the start
    "jog_speed": 5.0,        // yd/s walking up to the line
    "arrive_decel": 3.0,     // yd/s^2: easing into the alignment spot
    "set_seconds": 1.0,      // everyone set this long before the snap
    "max_seconds": 20
  },

  // Offense at the snap: it knows the count, so the delay is short.
  "get_off": {
    "skill": {"acceleration": 0.5, "anticipation": 0.5},
    "delay": {"curve": "linear", "points": [[0, 0.35], [100, 0.05]]},
    "noise_sd": 0.03
  },
  // Noticing something you didn't know was coming (a throw, a handoff).
  "reaction": {
    "skill": {"anticipation": 0.4, "concentration": 0.3, "decisions": 0.3},
    "delay": {"curve": "linear", "points": [[0, 0.55], [100, 0.10]]},
    "noise_sd": 0.04
  },

  // Busts: one roll per player at the snap against effective Playbook Knowledge
  // (scheme PK x the familiarity factor for the slot's position).
  // 100 -> 0.2%, 70 -> ~1.5%, 40 -> 10%, 1 -> 60%.
  "busts": {
    "familiarity_factor": {"curve": "linear", "points": [[0, 0.5], [100, 1.0]]},
    "chance": {"curve": "logistic", "mid": 7.07, "steepness": -0.0667},
    "late_release": [0.3, 0.8],     // s, extra delay
    "wrong_depth": [2.0, 4.0],      // yd, shorter or longer
    "similar_route_depth": 6.0      // yd: a wrong route breaks within this of the right one
  },

  "routes": {
    // Route Running -> sd of each waypoint's position error, yd.
    "precision_sd": {"curve": "linear", "points": [[20, 0.9], [95, 0.12]]},
    "arrive": 0.5,           // yd: close enough to a waypoint
    "sideline_margin": 2.5,  // yd: routes stay this far inside the sideline
    "decel_rate": 6.0        // yd/s^2: throttling down into a "decel" waypoint
  },

  "snap": {
    "exchange_seconds": 0.1,  // under center: center to QB
    "gun_speed": 15.0,        // yd/s, shotgun snap
    "catch_range": 0.9        // yd: the QB catches a gun snap this close to his hands
  },

  // Stand-ins until blocking exists (phase 6): linemen set or fire out and hold.
  "blocking_standin": {
    "pass_set_depth": 1.5,        // yd back
    "run_fire_out": 1.5,          // yd forward
    "run_lean": 0.7,              // yd toward the play side
    "stalk_depth": 4.0,           // yd downfield for stalk blocks
    "check_release_seconds": 1.0  // a back checks for blitzers this long, then releases
  },

  "run": {
    "handoff_range": 1.3,   // yd between QB and carrier
    "qb_mesh_offset": 0.9   // yd: the QB meets the mesh point from his side
  },

  "play": {
    "max_seconds": 15,           // whistle after this long (no defense to end it)
    "post_whistle_seconds": 1.5  // keep recording while everyone pulls up
  }
}
